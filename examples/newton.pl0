{ square root by Newton }
{ Start with a guess x and replace
  it by the average of x and a/x.
  The number of correct digits
  about doubles in every step,
  until the computer runs out of
  digits. Try a = 10 or a = 1000. }
const a = 2;
var x, r, i;
begin
  r := sqrt(a);
  !'sqrt('; !a; !') = '; !r; !; !;
  x := 1; i := 0;
  while i <= 5 do
  begin
    !'step '; !i; !': x = '; !x; !;
    !'   error = '; !x - r; !;
    x := (x + a/x) / 2;
    i := i + 1
  end
end.
